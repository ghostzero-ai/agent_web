# Copy to .env.selfhost. Never commit the real file.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=3000

POSTGRES_USER=agent_web
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=agent_web
DATABASE_URL=postgresql://agent_web:replace-with-a-long-random-password@postgres:5432/agent_web
CREDENTIAL_MASTER_KEY=replace-with-a-32-byte-base64url-key

# Optional legacy fallback. The preferred flow saves the user's Key from the
# /api-key page into encrypted server storage.
AI_API_KEY=replace-with-a-real-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_ALLOW_INSECURE_HTTP=false

# Optional reminder worker tuning. Defaults are suitable for one user.
REMINDER_WORKER_ID=
REMINDER_POLL_INTERVAL_MS=5000
SCHEDULER_BATCH_SIZE=20
SCHEDULER_LEASE_MS=60000
