# PostgreSQL connection used by Drizzle Kit and the migration commands.
# Copy this file to .env.local and replace the credentials locally.
DATABASE_URL=postgresql://agent_web:change-me@127.0.0.1:5432/agent_web

# 32 random bytes encoded as unpadded base64url. This encrypts model
# credentials saved from /api-key and must never use a NEXT_PUBLIC_ prefix.
CREDENTIAL_MASTER_KEY=replace-with-a-32-byte-base64url-key

# Optional legacy fallback when no credential has been saved from /api-key.
# Never prefix these with NEXT_PUBLIC_ or put real secrets in this example.
AI_API_KEY=replace-with-a-real-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# HTTP providers (for example a trusted LAN model server) are rejected unless
# the self-hosting administrator explicitly opts in.
AI_ALLOW_INSECURE_HTTP=false
